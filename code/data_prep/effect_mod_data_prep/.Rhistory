CTYFIPS = str_pad(
CTYFIPS,
width = 3,
side = 'left',
pad = '0'
),
STFIPS = str_pad(
STFIPS,
width = 2,
side = 'left',
pad = '0'
),
five_digit_fips = paste0(STFIPS, CTYFIPS),
urban = case_when(CODE2023 %in% c(1, 2, 3, 4) ~ 1,
TRUE ~ 0)
)
