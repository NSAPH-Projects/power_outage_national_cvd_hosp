)
)
wf_smoke <- wf_smoke %>%
mutate(day = ymd(date)) %>%
filter(lubridate::year(day) == 2018) %>%
rename(five_digit_fips = GEOID)
po_dat <- po_dat %>% left_join(wf_smoke) %>%
mutate(smoke = replace_na(smokePM_pred, 0)) %>%
mutate(any_smoke = ifelse(smoke > 0, 1, 0))
